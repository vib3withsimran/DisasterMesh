# DisasterMesh Frontend — Environment Variables
# Copy to .env.local — no edits needed for local demo.

# Backend API URL (where the FastAPI server is running)
NEXT_PUBLIC_API_URL=http://localhost:8000

# WebSocket URL for real-time event feed
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/updates

# No API key needed — uses free MapLibre GL JS with OpenStreetMap tiles.
