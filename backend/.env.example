# ─────────────────────────────────────────────────────────────────────────────
# DisasterMesh — backend environment variables
# Copy to .env and fill in values before running.
# ─────────────────────────────────────────────────────────────────────────────

# ── Qdrant ────────────────────────────────────────────────────────────────────
# Leave blank to use local file mode (no Docker needed).
# Set to Qdrant Cloud URL for production: https://xxxx.qdrant.io
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_LOCAL_PATH=./qdrant_data

# ── Redis / Upstash ───────────────────────────────────────────────────────────
# Upstash free tier: https://console.upstash.com
# Format: rediss://:PASSWORD@HOST:PORT
REDIS_URL=redis://localhost:6379

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite for dev, switch to postgres:// for production
DATABASE_URL=sqlite+aiosqlite:///./dev.db


# ── SMS Provider ────────────────────────────────────────────────────────────
# Option 1: Vonage (recommended — free tier: 200 SMS/month)
# Sign up: https://www.vonage.com/communications-apis/sms/
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM_NUMBER=DisasterMesh


# ── Exa Social Media Monitor (free tier: 1000 searches/month) ────────────────
# Sign up: https://exa.ai (get $20 free credits)
EXA_API_KEY=

# ── Data paths ────────────────────────────────────────────────────────────────
SENTINEL_DATA_DIR=./demo_data/satellite

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
