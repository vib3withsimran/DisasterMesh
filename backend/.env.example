# ─────────────────────────────────────────────────────────────────────────────
# DisasterMesh — backend environment variables
# Copy to .env or .env.local and fill in values before running.
# ─────────────────────────────────────────────────────────────────────────────

# ── Groq LLM (Required for live AI report parsing) ────────────────────────────
# Sign up & get free API key: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_S=10

# ── Qdrant Vector DB ─────────────────────────────────────────────────────────
# Leave blank to use local file mode (./qdrant_data, no Docker/network needed).
# Set to Qdrant Cloud URL for production: https://xxxx.qdrant.io
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_LOCAL_PATH=./qdrant_data

# ── Redis / Upstash ───────────────────────────────────────────────────────────
# Upstash free tier: https://console.upstash.com
# Format: rediss://:PASSWORD@HOST:PORT
REDIS_URL=redis://localhost:6379

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite for dev, switch to postgres:// for production
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# ── SMS Provider ────────────────────────────────────────────────────────────
# Option 1: Vonage (recommended — free tier: 200 SMS/month)
# Sign up: https://www.vonage.com/communications-apis/sms/
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM_NUMBER=DisasterMesh

# Option 2: Twilio (alternative)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Exa Social Media Monitor (free tier: 1000 searches/month) ────────────────
# Sign up: https://exa.ai (get $20 free credits)
EXA_API_KEY=

# ── Data paths ────────────────────────────────────────────────────────────────
SENTINEL_DATA_DIR=./demo_data/satellite

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
